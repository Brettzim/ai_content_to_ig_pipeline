XAI_API_KEY=your_xai_api_key_here

# Video settings
VIDEO_DURATION=10
VIDEO_ASPECT_RATIO=2:3
VIDEO_RESOLUTION=480p

# Paths
PHOTOS_DIR=./photos
EDITED_PHOTOS_DIR=./edited_photos
VIDEOS_DIR=./videos
LOGS_DIR=./logs
LOADS_DIR=./loads

# Instagram
ACCOUNTS_FILE=./accounts.json
IG_ACCESS_TOKEN=your_ig_access_token_here
IG_POST_DELAY=10

# Web UI auth (leave both blank to disable login)
WEB_UI_USERNAME=
WEB_UI_PASSWORD=
WEB_UI_SECRET=change_me_to_a_long_random_string

# Playwright browser mode — set to true on a Linux server, false for local dev
# (headless=true skips the visible window; first-time login must be done headful)
WEB_HEADLESS=false
